# ==============================================================================
# ai غزل الئطة | ملف الإعدادات والنموذج الافتراضي (.env.example)
# إعداد: قيس جازي
# ==============================================================================

# منفذ تشغيل الخادم
PORT=3000

# نموذج الذكاء الاصطناعي (يوصى بـ openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# مفاتيح Groq API (مفصولة بفاصلة للتدوير الآلي)
GROQ_API_KEYS=your_groq_api_key_here
